# =========================
# SYSTEM FILES
# =========================
.DS_Store
Thumbs.db

# =========================
# ENV / CONFIG SENSITIF
# =========================
.env

# =========================
# DEPENDENCIES
# =========================
/vendor/
/node_modules/

# =========================
# CODEIGNITER 3
# =========================

# Cache & session (INI YANG KEMARIN ERROR)
application/cache/*
!application/cache/index.html
!application/cache/.htaccess

# Logs
application/logs/*
!application/logs/index.html
!application/logs/.htaccess

# Upload (optional, tergantung kebutuhan)
uploads/*
!uploads/index.html

# =========================
# ASSETS
# =========================

# File yang diupload oleh user (data runtime, JANGAN masuk repo)
assets/uploaded/*
# Tapi tetap pertahankan struktur folder agar deployment tidak error
!assets/uploaded/logo/.gitkeep
!assets/uploaded/others/.gitkeep
!assets/uploaded/thumbnails/.gitkeep
!assets/uploaded/users/.gitkeep
!assets/uploaded/components/.gitkeep


# =========================
# CODEIGNITER 4
# =========================

# Writable folder (CI4)
writable/*
!writable/index.html
!writable/.htaccess

# =========================
# BUILD / TEMP
# =========================
*.log
*.tmp
*.temp

# =========================
# IDE / EDITOR
# =========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# =========================
# OS GENERATED
# =========================
*.swp
*.lock

# =========================
# TEST / COVERAGE
# =========================
coverage/